{
  "name": "multiweb-manager",
  "version": "0.0.3",
  "description": "MultiWeb Manager – zarządzaj wieloma kontami i narzędziami w jednej aplikacji",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run react-start\" \"wait-on http://localhost:3000 && electron .\"",
    "react-start": "cross-env BROWSER=none react-scripts start",
    "build": "react-scripts build",
    "make": "electron-forge make"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^16.5.0",
    "adm-zip": "^0.5.10",
    "axios": "^1.6.2",
    "chokidar": "^3.5.3",
    "diff": "^5.1.0",
    "electron-store": "^10.0.0",
    "lodash": "^4.17.21",
    "lucide-react": "^0.488.0",
    "node-pty": "^1.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.1",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-web-links": "^0.9.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.7.0",
    "@electron-forge/maker-squirrel": "^7.7.0",
    "autoprefixer": "^10.5.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^34.3.0",
    "eslint": "^8.57.1",
    "postcss": "^8.5.15",
    "react-scripts": "5.0.1",
    "tailwindcss": "^3.4.19",
    "wait-on": "^7.0.2"
  },
  "proxy": "http://localhost:3000",
  "config": {
    "forge": {
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "MultiWebManager",
            "setupIcon": "./assets/app-icon.ico",
            "setupExe": "MultiWebManager-Setup.exe",
            "shortcutName": "MultiWeb Manager",
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true
          }
        }
      ]
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
